{
  "info": {
    "_postman_id": "6b3e0c5a-2d7f-4b8e-9a1c-0f4d2e7b9c31",
    "name": "JSON Dataset Operators",
    "description": "Insert JSON records into a dataset and query them with groupBy / sortBy. Run the Insert folder first, then Query, then Errors. Variables: baseUrl, datasetName.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "datasetName",
      "value": "employee_dataset",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Insert",
      "item": [
        {
          "name": "Insert John Doe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Body confirms insert\", () => {",
                  "    pm.expect(json.message).to.eql(\"Record added successfully\");",
                  "    pm.expect(json.dataset).to.eql(pm.environment.get(\"datasetName\") || pm.collectionVariables.get(\"datasetName\"));",
                  "    pm.expect(json.recordId).to.eql(1);",
                  "});",
                  "pm.test(\"Location header present\", () => pm.response.to.have.header(\"Location\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"name\": \"John Doe\",\n  \"age\": 30,\n  \"department\": \"Engineering\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/dataset/{{datasetName}}/record",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dataset",
                "{{datasetName}}",
                "record"
              ]
            },
            "description": "Insert one of the three example records from the assignment PDF."
          }
        },
        {

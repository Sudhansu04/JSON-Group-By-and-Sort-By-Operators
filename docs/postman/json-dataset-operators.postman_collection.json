    {
      "name": "Query",
      "item": [
        {
          "name": "Group by department",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Has groupedRecords with Engineering and Marketing\", () => {",
                  "    pm.expect(json).to.have.property(\"groupedRecords\");",
                  "    pm.expect(json.groupedRecords).to.have.keys(\"Engineering\", \"Marketing\");",
                  "    pm.expect(json.groupedRecords.Engineering).to.have.lengthOf(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dataset/{{datasetName}}/query?groupBy=department",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dataset",
                "{{datasetName}}",
                "query"
              ],
              "query": [
                {
                  "key": "groupBy",
                  "value": "department"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Sort by age asc",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const ages = pm.response.json().sortedRecords.map(r => r.age);",
                  "pm.test(\"Ages ascending\", () => pm.expect(ages).to.eql([...ages].sort((a, b) => a - b)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dataset/{{datasetName}}/query?sortBy=age&order=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dataset",
                "{{datasetName}}",
                "query"
              ],
              "query": [
                {
                  "key": "sortBy",
                  "value": "age"
                },
                {
                  "key": "order",
                  "value": "asc"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Sort by age desc",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const ages = pm.response.json().sortedRecords.map(r => r.age);",
                  "pm.test(\"Ages descending\", () => pm.expect(ages).to.eql([...ages].sort((a, b) => b - a)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dataset/{{datasetName}}/query?sortBy=age&order=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dataset",
                "{{datasetName}}",
                "query"
              ],
              "query": [
                {
                  "key": "sortBy",
                  "value": "age"
                },
                {
                  "key": "order",
                  "value": "desc"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Group by department + sort by age",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const groups = pm.response.json().groupedRecords;",
                  "pm.test(\"Each group sorted by age ascending\", () => {",
                  "    Object.values(groups).forEach(list => {",
                  "        const ages = list.map(r => r.age);",
                  "        pm.expect(ages).to.eql([...ages].sort((a, b) => a - b));",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dataset/{{datasetName}}/query?groupBy=department&sortBy=age",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dataset",
                "{{datasetName}}",
                "query"
              ],
              "query": [
                {
                  "key": "groupBy",
                  "value": "department"
                },
                {
                  "key": "sortBy",
                  "value": "age"
                }
              ]
            },
            "description": ""
          }
        },
